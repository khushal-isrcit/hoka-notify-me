{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hoka-notify-me",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",

  // public/index.html is served for "/"; anything that is not a file
  // (e.g. /api/notify, /api/health) falls through to src/index.js.
  "assets": {
    "directory": "./public"
  },

  "workers_dev": true,
  // No per-version preview URLs: the API should only answer on one hostname.
  "preview_urls": false,

  // Keeps console.error output (including the Shopify scope/approval hints)
  // searchable under the Worker's Logs tab.
  "observability": {
    "enabled": true
  },

  // One codebase, one Worker per store. Store settings are NOT in this file:
  // each Worker gets them in the dashboard (Settings > Variables and Secrets):
  //   SHOPIFY_STORE_DOMAIN  text    e.g. your-store.myshopify.com
  //   ALLOWED_ORIGINS       text    e.g. https://www.hoka.example
  //   SHOPIFY_ADMIN_TOKEN   secret
  // keep_vars stops each deploy from wiping the dashboard text vars.
  "keep_vars": true,

  // Per-IP limits, counted per Cloudflare location. namespace_id only has to
  // be unique within the Cloudflare account; period must be 10 or 60.
  // one8-BIS already uses 1801-1804, so these stay clear of them in case both
  // Workers share a Cloudflare account.
  "ratelimits": [
    {
      "name": "NOTIFY_WRITE_LIMITER",
      "namespace_id": "1805",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "NOTIFY_READ_LIMITER",
      "namespace_id": "1806",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
